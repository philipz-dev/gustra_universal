  "scripts": {
    "postinstall": "node scripts/patch-expo-devtools-hang.js",
    "start": "expo start",
    "gustrarun": "bash scripts/gustrarun",
    "vistarun": "bash scripts/vistarun",
    "start:android": "$HOME/Library/Android/sdk/platform-tools/adb reverse tcp:8081 tcp:8081 && NODE_OPTIONS=--dns-result-order=ipv4first expo start --localhost --android",
    "android": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --localhost --android",
    "android:prebuild": "expo prebuild --platform android --clean",
    "android:run": "NODE_OPTIONS=--dns-result-order=ipv4first expo run:android",
    "android:apk": "expo prebuild --platform android --clean && cd android && ./gradlew assembleDebug",
    "android:eas:preview": "eas build --platform android --profile preview",
    "android:eas:dev": "eas build --platform android --profile development",
    "deploy": "bash scripts/deploy-store.sh",
    "deploy:ios": "bash scripts/deploy-ios-testflight.sh",
    "deploy:android": "bash scripts/deploy-android-internal.sh",
    "deploy:cloud": "bash scripts/deploy-store.sh --cloud",
    "deploy:credentials": "bash scripts/setup-store-credentials.sh",
    "deploy:web": "python3 scripts/deploy-webversion.py",
    "deploy:privacy": "python3 roadmap/deploy-privacy.py",
    "deploy:master": "python3 site/deploy-master.py",
    "deploy:localization": "python3 scripts/deploy-localization.py",
    "deploy:github": "python3 scripts/deploy-github.py",
    "i18n:check": "python3 scripts/check-i18n.py",
    "i18n:deploy": "python3 scripts/i18n-check-deploy.py",
    "build:sync:check": "bash scripts/check-build-sync.sh",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest",
    "test:ci": "jest --ci --coverage",
    "localization:build": "python3 scripts/generate-localization-site.py",
    "test:gemini": "bash scripts/test-gemini.sh",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "private": true,
  "allowScripts": {
    "@sentry/cli@2.58.4": true
  }
}
