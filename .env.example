# Copy to `.env` (never commit `.env`).
# Required for Places nearby/search + Maps (WebView JS + native Android config).
EXPO_PUBLIC_GOOGLE_API_KEY=

# Gemini (wine-label Vision). Separate from Maps/Places — Google AI Studio key.
# Bundled via EXPO_PUBLIC_ (local/test only; prefer a server proxy for production).
EXPO_PUBLIC_GEMINI_API_KEY=

# Sentry crash reporting (https://sentry.io — create a React Native project).
# DSN is public client key (ok in EXPO_PUBLIC_); auth token is secret.
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=gustra
# Auth token for source maps / dSYM on release builds — put in `.env.local` (gitignored).
# `scripts/deploy-store.sh` injects it into eas.json production.env for the build only, then restores.
# Cloud EAS: also `eas env:create --name SENTRY_AUTH_TOKEN --visibility sensitive --environment production`
# Archives never fail on upload: SENTRY_ALLOW_FAILURE=true in eas.json.
# SENTRY_AUTH_TOKEN=

# Local Google Cloud ADC (service account JSON under secrets/ — never commit).
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/gustra_universal/secrets/your-key.json
#
# Play Console submit (same or dedicated SA JSON; wired in eas.json serviceAccountKeyPath):
#   secrets/gustra-503718-….json  +  invite that SA as Release manager on net.gustra.app
#
# Optional App Store Connect API key (non-interactive TestFlight submit):
#   secrets/AuthKey_XXXXXXXXXX.p8
#   ASC_API_KEY_ID=
#   ASC_API_KEY_ISSUER_ID=
#   Setup checklist: bash scripts/setup-store-credentials.sh

# Google Cloud Console checklist for this key:
# 1) Enable APIs: Places API (New), Maps JavaScript API
#    (optional if you use native maps later: Maps SDK for Android)
# 2) For local Expo / emulator testing, prefer an unrestricted key OR
#    HTTP referrer allowlist that includes localhost, plus Android app
#    restriction for package `net.gustra.app` once you ship a release APK.
# 3) Restart Metro after changing this file (`npx expo start -c`).
#
# Android tester builds (local APK, no Expo account needed):
#   npm run android:apk
#   → android/app/build/outputs/apk/debug/app-debug.apk
#   adb install -r android/app/build/outputs/apk/debug/app-debug.apk
#
# Or install+run on a connected emulator/device (debug, with Metro):
#   npm run android:run
#
# Cloud EAS builds (requires `npx eas-cli login`):
#   npx eas-cli env:create --name EXPO_PUBLIC_GOOGLE_API_KEY --value "YOUR_KEY" --environment preview
#   npm run android:eas:preview
